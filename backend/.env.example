# ── IA: Google Gemini ─────────────────────────────────────────
# Crea tu clave en Google AI Studio y mantenla SOLO en este archivo del backend.
GEMINI_API_KEY=pega-aqui-tu-clave-de-google-ai-studio
GEMINI_MODEL=gemini-2.5-flash

# ── Seguridad ─────────────────────────────────────────────────
# Genera una clave aleatoria con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ── Base de datos ─────────────────────────────────────────────
# SQLite (desarrollo) — para PostgreSQL usa: postgresql://usuario:contraseña@host/db
DATABASE_URL=sqlite:///./exmi.db

# ── Token de sesión ───────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Archivos subidos ──────────────────────────────────────────
UPLOAD_DIR=uploads

# ── Servidor ──────────────────────────────────────────────────
PORT=8000
