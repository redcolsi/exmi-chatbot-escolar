# -- IA: Google Gemini (AI Studio) --
# Clave solo en servidor (.env local / env Vercel). Nunca en frontend.
GEMINI_API_KEY=pega-aqui-tu-clave-de-google-ai-studio
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# -- Seguridad --
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# -- Base de datos --
# Local (SQLite offline): sqlite:///./exmi.db
# Vercel sin DATABASE_URL: usa sqlite:////tmp/exmi.db con auto-seed (solo /tmp escribible)
# Supabase Postgres (pooler recomendado en serverless, puerto 6543):
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Supabase directa (puerto 5432):
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./exmi.db

# Supabase (opcional, para futuro uso REST/auth):
# SUPABASE_URL=https://[REF].supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_URL=
SUPABASE_ANON_KEY=

# -- Token de sesion --
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -- Archivos subidos --
UPLOAD_DIR=uploads

# -- Servidor --
PORT=8000
